<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    Liga de Fútbol
    Se va almacenar información relativa a partidos de una liga de fútbol
    Se va a registrar información del equipo local y del visitante
    Para ambos, se va almacenar su nombre y lod goles marcados
    Los elementos nombre y goles contienen cadena de caracteres
-->
<!DOCTYPE ligaDeFutbol [
  <!ELEMENT ligaDeFutbol (partido*)>
  <!ELEMENT partido (local, visitante)>
  <!ELEMENT local (nombre, goles)>
  <!ELEMENT visitante (nombre, goles)>
  <!ELEMENT nombre (#PCDATA)>
  <!ELEMENT goles (#PCDATA)>
]>

<ligaDeFutbol>
  <partido>
    <local>
      <nombre>Nottingham Presa</nombre>
      <goles>0</goles>
    </local>
    <visitante>
